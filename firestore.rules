rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Math12 Hub v40.30.0 — COMPLETE FIRESTORE RULES
    // Roles: admin / teacher / student
    // Default deny. First admin must be created from Firebase Console
    // (users/{UID}.role = "admin", accountStatus = "active").
    // ============================================================

    // ---------- Core identity helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(myUid()));
    }

    function profile() {
      return get(userPath(myUid())).data;
    }

    function active() {
      return hasProfile()
        && (!('accountStatus' in profile()) || profile().accountStatus != 'locked');
    }

    function isAdmin() {
      return active() && ('role' in profile()) && profile().role == 'admin';
    }

    function isTeacher() {
      return active()
        && ('role' in profile())
        && (profile().role == 'teacher' || profile().role == 'admin');
    }

    function isStudent() {
      return active()
        && (!('role' in profile()) || profile().role == 'student');
    }

    // ---------- Class helpers ----------
    function classPath(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function classExists(classId) {
      return exists(classPath(classId));
    }

    function classData(classId) {
      return get(classPath(classId)).data;
    }

    function classOwner(classId) {
      return isTeacher()
        && classExists(classId)
        && ('ownerId' in classData(classId))
        && classData(classId).ownerId == myUid();
    }

    function classUsable(classId) {
      return classExists(classId)
        && (!('status' in classData(classId)) || classData(classId).status != 'trashed')
        && (!('accessStatus' in classData(classId)) || classData(classId).accessStatus != 'locked');
    }

    function memberPath(classId, uid) {
      return /databases/$(database)/documents/classes/$(classId)/members/$(uid);
    }

    function activeMember(classId, uid) {
      return active()
        && classUsable(classId)
        && exists(memberPath(classId, uid))
        && (!('status' in get(memberPath(classId, uid)).data)
            || get(memberPath(classId, uid)).data.status == 'active');
    }

    function meActiveMember(classId) {
      return signedIn() && activeMember(classId, myUid());
    }

    // ---------- Assignment helpers ----------
    function assignmentPath(classId, assignmentId) {
      return /databases/$(database)/documents/classes/$(classId)/assignmentsV18/$(assignmentId);
    }

    function assignmentExists(classId, assignmentId) {
      return exists(assignmentPath(classId, assignmentId));
    }

    function assignmentData(classId, assignmentId) {
      return get(assignmentPath(classId, assignmentId)).data;
    }

    function assignmentMapTargets(data, uid) {
      return !(('targetMode' in data))
        || data.targetMode == 'all'
        || (
          ('targetUids' in data)
          && data.targetUids is list
          && data.targetUids.hasAny([uid])
        );
    }

    function assignmentTargets(classId, assignmentId, uid) {
      return assignmentExists(classId, assignmentId)
        && assignmentMapTargets(assignmentData(classId, assignmentId), uid);
    }

    function assignmentAcceptsNow(classId, assignmentId, uid) {
      return meActiveMember(classId)
        && assignmentExists(classId, assignmentId)
        && assignmentTargets(classId, assignmentId, uid)
        && (!('status' in assignmentData(classId, assignmentId))
            || assignmentData(classId, assignmentId).status != 'trashed')
        && (!('opensAt' in assignmentData(classId, assignmentId))
            || request.time >= assignmentData(classId, assignmentId).opensAt)
        && (!('dueAt' in assignmentData(classId, assignmentId))
            || request.time <= assignmentData(classId, assignmentId).dueAt);
    }

    function assignmentMaxAttempts(classId, assignmentId) {
      return ('maxAttempts' in assignmentData(classId, assignmentId))
        ? assignmentData(classId, assignmentId).maxAttempts
        : 1;
    }

    function validStudentAttemptNumber(classId, assignmentId) {
      return ('attemptNumber' in request.resource.data)
        && request.resource.data.attemptNumber is number
        && request.resource.data.attemptNumber >= 1
        && request.resource.data.attemptNumber <= assignmentMaxAttempts(classId, assignmentId);
    }

    function validStudentSubmission(classId, assignmentId, uid) {
      return assignmentAcceptsNow(classId, assignmentId, uid)
        && request.resource.data.uid == uid
        && request.resource.data.classId == classId
        && request.resource.data.assignmentId == assignmentId
        && request.resource.data.status == 'submitted'
        && request.resource.data.secureSchemaVersion == 18
        && validStudentAttemptNumber(classId, assignmentId)
        && (!('score' in request.resource.data))
        && (!('questionResults' in request.resource.data))
        && (!('gradedBy' in request.resource.data))
        && (!('gradedAt' in request.resource.data))
        && (!('gradingVersion' in request.resource.data))
        && (!('durationMs' in request.resource.data)
            || (request.resource.data.durationMs is number
                && request.resource.data.durationMs >= 0
                && request.resource.data.durationMs <= 14400000))
        && (!('violations' in request.resource.data)
            || (request.resource.data.violations is number
                && request.resource.data.violations >= 0));
    }

    function canRevealAnswerKey(classId, assignmentId) {
      return meActiveMember(classId)
        && assignmentExists(classId, assignmentId)
        && assignmentTargets(classId, assignmentId, myUid())
        && ('revealPolicy' in assignmentData(classId, assignmentId))
        && (
          (
            assignmentData(classId, assignmentId).revealPolicy == 'after_due'
            && ('dueAt' in assignmentData(classId, assignmentId))
            && request.time >= assignmentData(classId, assignmentId).dueAt
          )
          ||
          (
            assignmentData(classId, assignmentId).revealPolicy == 'after_grade'
            && exists(/databases/$(database)/documents/classes/$(classId)/assignmentsV18/$(assignmentId)/submissions/$(myUid()))
            && ('score' in get(/databases/$(database)/documents/classes/$(classId)/assignmentsV18/$(assignmentId)/submissions/$(myUid())).data)
          )
        );
    }

    // ============================================================
    // 1) USERS / ACCOUNT PROFILE
    // ============================================================
    match /users/{uid} {
      // A user can always read their own profile so the app can detect a locked account.
      // Admin can inspect all profiles.
      allow get: if signedIn() && (uid == myUid() || isAdmin());
      allow list: if isAdmin();

      // New Firebase Auth accounts may only bootstrap themselves as student/active.
      allow create: if signedIn()
        && uid == myUid()
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'role', 'accountStatus',
          'emailVerified', 'schemaVersion', 'createdAt', 'lastLoginAt', 'updatedAt'
        ]);

      // Admin manages other users. A normal user can update only non-privileged fields.
      allow update: if isAdmin()
        || (
          active()
          && uid == myUid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'uid', 'role', 'accountStatus', 'createdAt', 'adminUpdatedAt', 'adminUpdatedBy'
          ])
        );

      allow delete: if isAdmin();

      // ---------- Learning snapshot ----------
      match /learning/{docId} {
        allow read, create, update, delete: if active() && uid == myUid();
      }

      // ---------- Teacher private content ----------
      match /questionBank/{docId} {
        allow read, create, update, delete: if active() && uid == myUid() && isTeacher();
      }

      match /customExams/{docId} {
        allow read, create, update, delete: if active() && uid == myUid() && isTeacher();
      }

      match /recycleBinV26/{docId} {
        allow read, create, update, delete: if active() && uid == myUid() && isTeacher();
      }

      match /syncMeta/{docId} {
        allow read, create, update, delete: if active() && uid == myUid() && isTeacher();
      }

      // ---------- User ↔ class access mirror ----------
      match /memberships/{classId} {
        allow read: if isAdmin() || (active() && uid == myUid());

        // User joins/refreshes only when the matching class member exists after this write.
        // Class owner/admin may repair, transfer, suspend or restore memberships.
        allow create, update: if isAdmin()
          || classOwner(classId)
          || (
            active()
            && uid == myUid()
            && getAfter(memberPath(classId, uid)).data.uid == uid
            && request.resource.data.classId == classId
            && request.resource.data.status == getAfter(memberPath(classId, uid)).data.status
            && request.resource.data.joinCode == getAfter(memberPath(classId, uid)).data.joinCode
          );

        allow delete: if isAdmin() || classOwner(classId) || (active() && uid == myUid());
      }

      // ---------- Append-only personal audit ----------
      match /audit/{auditId} {
        allow read: if isAdmin() || (active() && uid == myUid());
        allow create: if active()
          && uid == myUid()
          && request.resource.data.actorUid == uid;
        allow update, delete: if false;
      }

      // Any unknown user subcollection is denied by default.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ============================================================
    // 2) CLASS JOIN CODES
    // ============================================================
    match /joinCodes/{code} {
      // Students may resolve a code they already know, but cannot list all codes.
      allow get: if active();
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (
          isTeacher()
          && request.resource.data.ownerId == myUid()
          && request.resource.data.classId is string
          && getAfter(classPath(request.resource.data.classId)).data.ownerId == myUid()
          && getAfter(classPath(request.resource.data.classId)).data.joinCode == code
        );

      allow update: if isAdmin()
        || (
          isTeacher()
          && resource.data.ownerId == myUid()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.classId == resource.data.classId
        );

      allow delete: if isAdmin()
        || (
          isTeacher()
          && resource.data.ownerId == myUid()
        );
    }

    // ============================================================
    // 3) CLASSES
    // ============================================================
    match /classes/{classId} {
      // Student may get only a class they actively belong to.
      // Teacher list queries are constrained by ownerId == current UID.
      allow get: if isAdmin() || classOwner(classId) || meActiveMember(classId);
      allow list: if isAdmin()
        || (isTeacher() && resource.data.ownerId == myUid());

      allow create: if isTeacher()
        && request.resource.data.ownerId == myUid()
        && request.resource.data.status == 'active'
        && (!('accessStatus' in request.resource.data)
            || request.resource.data.accessStatus == 'active');

      // Class owner cannot transfer ownership or override an admin access lock.
      allow update: if isAdmin()
        || (
          classOwner(classId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'ownerId', 'accessStatus'
          ])
        );

      // UI only permanently purges a class after it is in Trash.
      allow delete: if isAdmin()
        || (classOwner(classId) && resource.data.status == 'trashed');

      // ---------- Class members ----------
      match /members/{uid} {
        allow get: if isAdmin() || classOwner(classId) || (active() && uid == myUid());
        allow list: if isAdmin() || classOwner(classId);

        // Self-join is CREATE only. A suspended learner cannot re-join to unlock themselves.
        allow create: if isAdmin()
          || classOwner(classId)
          || (
            active()
            && uid == myUid()
            && request.resource.data.uid == uid
            && request.resource.data.classId == classId
            && request.resource.data.role == 'student'
            && request.resource.data.status == 'active'
            && request.resource.data.joinCode is string
            && exists(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode))
            && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.classId == classId
            && get(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.status == 'active'
            && classUsable(classId)
          );

        allow update: if isAdmin() || classOwner(classId);
        allow delete: if isAdmin() || classOwner(classId) || (active() && uid == myUid());
      }

      // ---------- Student self-reported learning progress ----------
      match /progress/{uid} {
        allow read: if isAdmin() || classOwner(classId) || (active() && uid == myUid());
        allow create, update: if isAdmin()
          || classOwner(classId)
          || (active() && uid == myUid() && meActiveMember(classId));
        allow delete: if isAdmin() || classOwner(classId) || (active() && uid == myUid());
      }

      // ---------- Legacy assignments: teacher/admin migration only ----------
      match /assignments/{assignmentId} {
        allow read, create, update, delete: if isAdmin() || classOwner(classId);

        match /submissions/{uid} {
          allow read, create, update, delete: if isAdmin() || classOwner(classId);
        }
      }

      // ---------- Secure public assignment shell ----------
      match /assignmentsV18/{assignmentId} {
        allow read: if isAdmin()
          || classOwner(classId)
          || (meActiveMember(classId) && assignmentMapTargets(resource.data, myUid()));
        allow create, update, delete: if isAdmin() || classOwner(classId);

        // Full answers submitted by the student; score fields are teacher-only.
        match /submissions/{uid} {
          allow read: if isAdmin() || classOwner(classId) || (active() && uid == myUid());

          allow create: if active()
            && uid == myUid()
            && validStudentSubmission(classId, assignmentId, uid);

          // Multiple attempts may overwrite the current ungraded submission.
          // Once teacher grading adds score, the student cannot overwrite it.
          allow update: if (
              active()
              && uid == myUid()
              && !('score' in resource.data)
              && validStudentSubmission(classId, assignmentId, uid)
            )
            || isAdmin()
            || classOwner(classId);

          allow delete: if isAdmin() || classOwner(classId);
        }

        // Immutable history row created by the student for each attempt.
        match /attemptHistoryV27/{historyId} {
          allow read: if isAdmin()
            || classOwner(classId)
            || (active() && resource.data.uid == myUid());

          allow create: if active()
            && request.resource.data.uid == myUid()
            && request.resource.data.classId == classId
            && request.resource.data.assignmentId == assignmentId
            && request.resource.data.status == 'submitted'
            && request.resource.data.secureSchemaVersion == 18
            && validStudentAttemptNumber(classId, assignmentId)
            && assignmentAcceptsNow(classId, assignmentId, myUid())
            && !('score' in request.resource.data)
            && !('gradedBy' in request.resource.data);

          allow update: if false;
          allow delete: if isAdmin() || classOwner(classId);
        }

        // Cloud autosave: only the student's own draft document.
        match /draftsV30/{uid} {
          allow read: if isAdmin() || classOwner(classId) || (active() && uid == myUid());

          allow create, update: if active()
            && uid == myUid()
            && assignmentAcceptsNow(classId, assignmentId, uid)
            && request.resource.data.uid == uid
            && request.resource.data.classId == classId
            && request.resource.data.assignmentId == assignmentId
            && request.resource.data.draftSchemaVersion == 30;

          allow delete: if isAdmin() || classOwner(classId) || (active() && uid == myUid());
        }
      }

      // ---------- Secure answer key ----------
      match /answerKeysV18/{assignmentId} {
        allow get: if isAdmin() || classOwner(classId) || canRevealAnswerKey(classId, assignmentId);
        allow list: if isAdmin() || classOwner(classId);
        allow create, update, delete: if isAdmin() || classOwner(classId);
      }

      // ---------- Lightweight submission state index ----------
      match /submissionIndexV19/{indexId} {
        allow get: if isAdmin()
          || classOwner(classId)
          || (active() && resource.data.uid == myUid());

        // Student queries use where('uid','==',currentUid); Firestore can prove this rule.
        allow list: if isAdmin()
          || classOwner(classId)
          || (active() && resource.data.uid == myUid());

        allow create: if isAdmin()
          || classOwner(classId)
          || (
            active()
            && request.resource.data.uid == myUid()
            && request.resource.data.classId == classId
            && request.resource.data.assignmentId is string
            && assignmentAcceptsNow(classId, request.resource.data.assignmentId, myUid())
            && request.resource.data.status == 'submitted'
            && request.resource.data.indexSchemaVersion == 19
            && !('score' in request.resource.data)
            && !('gradedBy' in request.resource.data)
            && !('gradedAt' in request.resource.data)
          );

        allow update: if isAdmin()
          || classOwner(classId)
          || (
            active()
            && resource.data.uid == myUid()
            && !('score' in resource.data)
            && resource.data.status != 'graded'
            && request.resource.data.uid == myUid()
            && request.resource.data.classId == classId
            && request.resource.data.assignmentId is string
            && assignmentAcceptsNow(classId, request.resource.data.assignmentId, myUid())
            && request.resource.data.status == 'submitted'
            && request.resource.data.indexSchemaVersion == 19
            && !('score' in request.resource.data)
            && !('gradedBy' in request.resource.data)
            && !('gradedAt' in request.resource.data)
          );

        allow delete: if isAdmin() || classOwner(classId);
      }

      // ---------- Verified aggregate written only by teacher/admin ----------
      match /studentStatsV19/{uid} {
        allow read: if isAdmin() || classOwner(classId) || (active() && uid == myUid());
        allow create, update, delete: if isAdmin() || classOwner(classId);
      }

      // ---------- Teacher operations ----------
      match /rosterV27/{docId} {
        allow read, create, update, delete: if isAdmin() || classOwner(classId);
      }

      match /groupsV27/{docId} {
        allow read, create, update, delete: if isAdmin() || classOwner(classId);
      }

      match /transfersV27/{docId} {
        allow read, create, update, delete: if isAdmin() || classOwner(classId);
      }

      // ---------- Expiring parent report links ----------
      match /reportsV33/{token} {
        // Anyone possessing the unguessable token can open an ACTIVE, non-expired snapshot.
        allow get: if isAdmin()
          || classOwner(classId)
          || (
            ('public' in resource.data) && resource.data.public == true
            && ('status' in resource.data) && resource.data.status == 'active'
            && ('expiresAt' in resource.data) && request.time < resource.data.expiresAt
          );

        allow list: if isAdmin() || classOwner(classId);
        allow create, update, delete: if isAdmin() || classOwner(classId);
      }

      // Any unknown class subcollection is denied by default.
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // ============================================================
    // 4) ADMIN AUDIT — append only
    // ============================================================
    match /adminAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == myUid();
      allow update, delete: if false;
    }

    // ============================================================
    // 5) GLOBAL PUBLIC QUESTION BANK v40.11
    // ============================================================
    match /publicQuestionBankV4011/{docId} {
      allow read: if active();

      // Current v40.30 client lets teacher/admin publish approved shared-bank chunks.
      // If only one canonical publisher is desired later, move this write to backend/admin.
      allow create, update, delete: if isTeacher();
    }

    // ============================================================
    // 6) GLOBAL HALL OF FAME v40.9
    // ============================================================
    match /honorPublicV409/{uid} {
      allow read: if active();

      // Only students publish their own sanitized summary document.
      allow create, update: if isStudent()
        && uid == myUid()
        && request.resource.data.schemaVersion == 409;

      allow delete: if isAdmin() || (active() && uid == myUid());
    }

    // ============================================================
    // 7) ARENA v40.26
    // Casual realtime competition. Client-side score verification is NOT
    // sufficient for high-stakes/official exams; use trusted backend for that.
    // ============================================================
    match /arenaRooms/{roomId} {
      function arenaRoomActive() {
        return resource.data.status == 'active';
      }

      function arenaOwner() {
        return active()
          && ('ownerUid' in resource.data)
          && resource.data.ownerUid == myUid();
      }

      function validArenaStatus(s) {
        return s == 'waiting' || s == 'active' || s == 'finished';
      }

      allow get: if active();
      allow list: if isAdmin();

      allow create: if active()
        && roomId.size() == 6
        && request.resource.data.ownerUid == myUid()
        && request.resource.data.code == roomId
        && request.resource.data.schemaVersion == 4026
        && request.resource.data.status == 'waiting';

      allow update: if arenaOwner()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && validArenaStatus(request.resource.data.status)
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'waiting' && request.resource.data.status == 'active')
          || (resource.data.status == 'finished' && request.resource.data.status == 'active')
          || (resource.data.status == 'active' && request.resource.data.status == 'finished')
        );

      allow delete: if arenaOwner() || isAdmin();

      match /players/{uid} {
        function self() {
          return active() && myUid() == uid;
        }

        function parentRoom() {
          return get(/databases/$(database)/documents/arenaRooms/$(roomId)).data;
        }

        function validScore() {
          return !('score' in request.resource.data)
            || (request.resource.data.score is number
                && request.resource.data.score >= 0
                && request.resource.data.score <= 10);
        }

        function validDuration() {
          return !('durationMs' in request.resource.data)
            || (request.resource.data.durationMs is number
                && request.resource.data.durationMs >= 0
                && request.resource.data.durationMs <= 14400000);
        }

        function scoreMatchesActiveRound() {
          return parentRoom().status == 'active'
            && ('roundId' in parentRoom())
            && ('lastRound' in request.resource.data)
            && request.resource.data.lastRound == parentRoom().roundId;
        }

        function scoringFieldsChanged() {
          return request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'score', 'durationMs', 'attemptId', 'lastRound', 'submittedAt'
          ]);
        }

        allow read: if active();

        allow create: if self()
          && request.resource.data.uid == uid
          && validScore()
          && validDuration()
          && (
            !('score' in request.resource.data)
            || scoreMatchesActiveRound()
          );

        allow update: if self()
          && request.resource.data.uid == uid
          && validScore()
          && validDuration()
          && (
            !scoringFieldsChanged()
            || scoreMatchesActiveRound()
          );

        allow delete: if self() || isAdmin();
      }
    }

    // ============================================================
    // 8) ADMIN COLLECTION-GROUP READS
    // v40.30 System Health uses collectionGroup() for these IDs.
    // Firestore Rules v2 requires explicit recursive-wildcard matches.
    // ============================================================
    match /{path=**}/members/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/memberships/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/assignmentsV18/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/answerKeysV18/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/submissionIndexV19/{docId} {
      allow read: if isAdmin();
    }

    // ============================================================
    // 9) DEFAULT DENY
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
